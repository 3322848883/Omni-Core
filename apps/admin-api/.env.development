# ============================================
# Server Configuration
# ============================================
PORT=3005

# ============================================
# Database Configuration (SQLite - Development)
# ============================================
USE_SQLITE=true
DB_CLIENT=better-sqlite3
DB_FILENAME=./dev.sqlite3

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=d9970141f6e33b06479d40106875db3b8c4e2a72b2391021c8ee53eb83f7aa3931691e57ee32613bca530c92e8af73457faebea22e299b05f6fcf03847c9387f
JWT_REFRESH_SECRET=8f6db7c4d28b73c8cbec0aa9e9067a7410bbccab0be6b1041686803976ef80392cca6660127b79cb3f952f875399d7ca324708099bb48b59fa389338c89e83aa
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ============================================
# Payment - Stripe (Test Keys)
# Get your test keys from: https://dashboard.stripe.com/test/apikeys
# ============================================
STRIPE_SECRET_KEY=sk_test_51OExample1234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_example_webhook_secret_12345
STRIPE_PUBLISHABLE_KEY=pk_test_51OExample1234567890abcdef

# ============================================
# Payment - PayPal (Sandbox)
# Get sandbox credentials from: https://developer.paypal.com/dashboard/applications/sandbox
# ============================================
PAYPAL_CLIENT_ID=AYXExamplePayPalClientID123456789
PAYPAL_CLIENT_SECRET=EExamplePayPalSecret123456789
PAYPAL_WEBHOOK_SECRET=paypal_webhook_secret_example
PAYPAL_SANDBOX=true

# ============================================
# Payment - Alipay (Personal QR Code)
# Upload your Alipay personal QR code image and set the URL
# ============================================
ALIPAY_QR_CODE_URL=/uploads/payment/alipay-qr.png
ALIPAY_RECEIVER_NAME=您的支付宝昵称

# ============================================
# Payment - WeChat (Personal QR Code)
# Upload your WeChat personal QR code image and set the URL
# ============================================
WECHAT_QR_CODE_URL=/uploads/payment/wechat-qr.png
WECHAT_RECEIVER_NAME=您的微信昵称

# ============================================
# Payment - Alipay Merchant (Official API)
# Apply at: https://open.alipay.com/
# ============================================
ALIPAY_MERCHANT_APP_ID=your_alipay_app_id
ALIPAY_MERCHANT_PRIVATE_KEY=your_private_key
ALIPAY_MERCHANT_PUBLIC_KEY=alipay_public_key
ALIPAY_MERCHANT_SANDBOX=true

# ============================================
# Payment - WeChat Merchant (Official API)
# Apply at: https://pay.weixin.qq.com/
# ============================================
WECHAT_MERCHANT_MCH_ID=your_merchant_id
WECHAT_MERCHANT_APP_ID=your_app_id
WECHAT_MERCHANT_API_KEY=your_api_key
WECHAT_MERCHANT_SANDBOX=true

# Default currency for payments
PAYMENT_DEFAULT_CURRENCY=USD

# ============================================
# Payment - General
# ============================================
PAYMENT_DEFAULT_CURRENCY=USD

# ============================================
# Frontend URL
# ============================================
ADMIN_WEB_URL=http://localhost:5173

# ============================================
# Server Configuration (Additional)
# ============================================
HOST=0.0.0.0
NODE_ENV=development

# ============================================
# API Configuration
# ============================================
API_PREFIX=/api/v1/admin

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Email Configuration (Optional)
# 用于发送个人收款码支付通知邮件
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=FGVPN Admin <noreply@embarks.uk>
# ADMIN_EMAIL=admin@yourdomain.com  # 接收通知邮件的管理员邮箱

# ============================================
# Xray Service Configuration
# ============================================
XRAY_API_HOST=localhost
XRAY_API_PORT=10085

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================
# Security
# ============================================
BCRYPT_ROUNDS=10
