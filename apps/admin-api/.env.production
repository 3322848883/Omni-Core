# Database Configuration
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=omnicore_admin
DB_USER=omnicore
DB_PASSWORD=your_database_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Payment - Stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Payment - PayPal
PAYPAL_CLIENT_ID=placeholder
PAYPAL_CLIENT_SECRET=placeholder
PAYPAL_WEBHOOK_SECRET=placeholder
PAYPAL_SANDBOX=true

# Payment - General
PAYMENT_DEFAULT_CURRENCY=USD

# Frontend URL
ADMIN_WEB_URL=http://localhost:5173

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Domain Configuration
DOMAIN_ROOT=localhost
DOMAIN_ADMIN=localhost
DOMAIN_API=localhost
DOMAIN_CLIENT=localhost
DOMAIN_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Xray Service Configuration
XRAY_API_HOST=localhost
XRAY_API_PORT=10085

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12

# IPData API Key for IP reputation checking
IPDATA_API_KEY=your_ipdata_api_key_here
