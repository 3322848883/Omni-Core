# Example Environment Configuration
# FGVPN Admin Web
# Copy this file to .env.local and update the values

# ============================================
# API Configuration
# ============================================
# Base URL for API requests
# Production: https://api.embarks.uk/v1/admin
# Staging: https://staging-api.embarks.uk/v1/admin
# Development: http://localhost:3001/api/v1/admin
VITE_API_BASE_URL=http://localhost:3001/api/v1/admin

# ============================================
# Application Settings
# ============================================
# Application title displayed in browser tab
VITE_APP_TITLE=FGVPN Admin

# Application version
VITE_APP_VERSION=1.0.0

# Application description
VITE_APP_DESCRIPTION=FGVPN Management System

# ============================================
# Feature Flags
# ============================================
# Enable mock API responses (true/false)
VITE_ENABLE_MOCK=true

# Enable debug mode with detailed logging (true/false)
VITE_ENABLE_DEBUG=true

# ============================================
# Monitoring (Optional)
# ============================================
# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
