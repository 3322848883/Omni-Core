# Client API Configuration
NODE_ENV=production
PORT=3002

# Database
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=omnicore_client
DB_USER=omnicore
DB_PASSWORD=omnicore123

# JWT Configuration
JWT_SECRET=omnicore_client_jwt_secret_prod_2024
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Payment (PayPal)
PAYPAL_CLIENT_ID=placeholder
PAYPAL_CLIENT_SECRET=placeholder
PAYPAL_MODE=sandbox

# Subscription
SUBSCRIPTION_BASE_URL=http://localhost:3002

# Security
BCRYPT_ROUNDS=10
