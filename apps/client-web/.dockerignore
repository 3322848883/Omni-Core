# ============================================
# Docker Ignore File
# ============================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build output
dist
dist-ssr
*.local

# Environment files (except example)
.env
.env.local
.env.*.local
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo
*~
.DS_Store

# Testing
coverage
.nyc_output

# Logs
logs
*.log

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github

# Documentation
*.md
docs

# Docker files (avoid recursion)
Dockerfile
docker-compose.yml
.dockerignore

# Scripts (not needed in image)
scripts

# Temporary files
tmp
temp
*.tmp

# OS files
Thumbs.db
