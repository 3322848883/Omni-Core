# Client Web App Environment Variables Example
# Copy this file to .env.local or create specific environment files

# ============================================
# API Configuration
# ============================================
# Development: http://localhost:3002/api/v1
# Staging: https://staging-api.embarks.uk/v1
# Production: https://api.embarks.uk/v1
VITE_API_BASE_URL=http://localhost:3002/api/v1

# ============================================
# App Configuration
# ============================================
VITE_APP_TITLE=FGVPN Client
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=FGVPN Client Web Application

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEBUG=false

# ============================================
# Monitoring & Analytics (Optional)
# ============================================
# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Google Analytics ID
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# Security Configuration
# ============================================
# Content Security Policy nonce (optional)
# VITE_CSP_NONCE=
