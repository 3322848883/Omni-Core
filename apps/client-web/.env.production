# Client Web Production Configuration
NODE_ENV=production

# API Base URL
VITE_API_BASE_URL=https://api.embark.uk/api/v1/client
VITE_ADMIN_API_URL=https://api.embark.uk/api/v1/admin

# App Configuration
VITE_APP_NAME=OmniCore VPN
VITE_APP_VERSION=1.0.0

# Domain Configuration
VITE_DOMAIN=embark.uk
VITE_APP_URL=https://app.embark.uk

# Feature Flags
VITE_ENABLE_PAYMENT=true
VITE_ENABLE_SUBSCRIPTION=true
