# Staging Environment Variables

# ============================================
# API Configuration
# ============================================
VITE_API_BASE_URL=https://staging-api.embarks.uk/v1

# ============================================
# App Configuration
# ============================================
VITE_APP_TITLE=FGVPN Client (Staging)
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=FGVPN Client Web Application - Staging Environment

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEBUG=true

# ============================================
# Monitoring & Analytics (Optional)
# ============================================
# Sentry DSN for error tracking (staging project)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Google Analytics ID (staging property)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
