{
  "name": "@omnicore/client-web",
  "version": "1.0.0",
  "description": "Omni Core Client Web Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:staging": "vue-tsc && vite build --mode staging",
    "build:production": "vue-tsc && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,vue,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,scss}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "deploy": "bash scripts/deploy.sh",
    "deploy:staging": "bash scripts/deploy.sh -e staging",
    "deploy:production": "bash scripts/deploy.sh -e production",
    "deploy:docker": "bash scripts/deploy.sh -d",
    "rollback:staging": "bash scripts/deploy.sh -e staging -r",
    "rollback:production": "bash scripts/deploy.sh -e production -r",
    "docker:build": "docker build -t fgvpn-client-web:latest .",
    "docker:build:staging": "docker build --build-arg ENV_FILE=.env.staging -t fgvpn-client-web:staging .",
    "docker:build:production": "docker build --build-arg ENV_FILE=.env.production -t fgvpn-client-web:production .",
    "docker:run": "docker run -p 8080:8080 fgvpn-client-web:latest",
    "docker:compose:dev": "docker-compose --profile dev up -d",
    "docker:compose:staging": "docker-compose --profile staging up -d",
    "docker:compose:prod": "docker-compose --profile prod up -d",
    "docker:compose:down": "docker-compose down"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "echarts": "^5.4.3",
    "element-plus": "^2.5.3",
    "pinia": "^2.1.7",
    "qrcode.vue": "^3.4.1",
    "vue": "^3.4.15",
    "vue-clipboard3": "^2.0.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.3",
    "@playwright/test": "^1.40.0",
    "@rushstack/eslint-patch": "^1.7.2",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vitest/coverage-v8": "^1.2.2",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.21.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.70.0",
    "terser": "^5.46.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.2",
    "vue-tsc": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
